# Copie de ce fichier en .env, remplie à la main. Inutile en développement
# local si les variables sont déjà dans le shell.

# Mot de passe du site, généré par `python -m app.auth` (sans lui, la page de
# connexion refuse tout le monde).
# LC_PASSWORD_HASH=scrypt$16384$8$1$...

# Voix de synthèse : sans cette clé, le texte de la langue cible n'est pas
# audible, le reste fonctionne.
# CARTESIA_API_KEY=...
# CARTESIA_VOICE_ID=...      # optionnel : épingle une voix pour toutes les
#                            # langues (sinon la voix du paquet, ou celle
#                            # choisie dans les Paramètres du site)

# Modèle. Le choix fait dans les Paramètres du site (data/settings.json)
# l'emporte sur ces valeurs, sans redéployer.
# Provider : gemini (OAuth Antigravity, défaut) ou opencode (OpenCode Go).
# LC_PROVIDER=opencode
# OPENCODE_API_KEY=oc_...    # requis si LC_PROVIDER=opencode
# LC_MODEL=deepseek-v4.1-flash   # (gemini : gemini-3.8-flash-tiered)

# Divers
# LC_DATA_DIR=./data         # carnet, audio, réglages, jeton OAuth
# LC_PORT=51121              # le port du redirect Google est épinglé : 51121
# LC_TIMEZONE=Europe/Paris   # fuseau des dates montrées au coach
# LC_COOKIE_SECURE=1         # cookies uniquement en HTTPS (derrière un reverse proxy)
# LC_SESSION_SECRET=...      # sinon un secret est créé dans data/
